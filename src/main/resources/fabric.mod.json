  "entrypoints": {
    "client": ["dev.zeroinputlag.ZeroInputLagClient"]
  },
  "mixins": ["zeroinputlag.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  }
}
